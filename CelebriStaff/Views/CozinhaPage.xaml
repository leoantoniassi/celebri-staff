<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             xmlns:controls="clr-namespace:CelebriStaff.Views.Controls"
             xmlns:behaviors="clr-namespace:CelebriStaff.Views.Behaviors"
             x:Class="CelebriStaff.Views.CozinhaPage"
             x:DataType="vm:CozinhaViewModel"
             behaviors:PageEntrance.Enabled="True"
             Title="Cozinha">

    <ContentPage.Resources>
        <!-- Aba: inativa = texto neutro; ativa (DataTrigger) = gradiente da marca. -->
        <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{DynamicResource ColorTextSecondary}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12" RowSpacing="14">
        <VerticalStackLayout Spacing="3">
            <Label Text="COZINHA DO EVENTO" Style="{StaticResource Eyebrow}" />
            <Label Text="{Binding EventoNome}" Style="{StaticResource TitleText}" FontSize="24"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding Publico}" Style="{StaticResource CaptionText}" />
            <controls:ErrorBanner Message="{Binding Erro}" Margin="0,8,0,0" />
        </VerticalStackLayout>

        <!-- Abas (segmented control) -->
        <Border Grid.Row="1" Padding="5" StrokeShape="RoundRectangle 18"
                BackgroundColor="{DynamicResource ColorSurfaceAlt}" StrokeThickness="0">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <Button Style="{StaticResource TabButtonStyle}" Text="{Binding TituloPedidos}"
                        Command="{Binding MudarAbaCommand}" CommandParameter="pedidos"
                        SemanticProperties.Description="Aba de pedidos">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding AbaPedidos}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" />
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorOnGradient}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource TabButtonStyle}" Text="Cardápio"
                        Command="{Binding MudarAbaCommand}" CommandParameter="cardapio"
                        SemanticProperties.Description="Aba do cardápio">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding AbaCardapio}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" />
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorOnGradient}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource TabButtonStyle}" Text="Estoque"
                        Command="{Binding MudarAbaCommand}" CommandParameter="estoque"
                        SemanticProperties.Description="Aba do estoque">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding AbaEstoque}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" />
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorOnGradient}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>

        <!-- Pedidos dos garçons, mais antigos primeiro -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Pedidos}" IsVisible="{Binding AbaPedidos}" SelectionMode="None">
            <CollectionView.EmptyView>
                <controls:EmptyStateView Icon="{StaticResource IconReceipt}"
                                         Title="Nenhum pedido aberto"
                                         Message="Os pedidos dos garçons aparecem aqui assim que forem enviados." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PedidoNaCozinha">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16" StrokeShape="RoundRectangle 20">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                <BoxView WidthRequest="4" HeightRequest="42" CornerRadius="2"
                                         Color="{Binding Cor}" VerticalOptions="Center" />
                                <Border Grid.Column="1" Style="{StaticResource IconTileStyle}"
                                        WidthRequest="42" HeightRequest="42"
                                        BackgroundColor="{DynamicResource ColorAccentSoft}">
                                    <Label Text="{StaticResource IconReceipt}"
                                           Style="{StaticResource IconLabelOnAccent}" FontSize="20" />
                                </Border>
                                <VerticalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Cabecalho}" FontFamily="PlusJakartaSansSemibold" FontSize="16" />
                                    <Label Text="PEDIDO À COZINHA" Style="{StaticResource Eyebrow}" FontSize="10" />
                                </VerticalStackLayout>
                            </Grid>

                            <controls:StatusChip Text="{Binding Status}" Kind="{Binding StatusKind}" />

                            <Border Style="{StaticResource SoftCardStyle}" Padding="12,10">
                                <Label Text="{Binding Itens}" FontSize="15" />
                            </Border>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Style="{StaticResource CompactButtonStyle}" Text="Começar" IsVisible="{Binding PodeComecar}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CozinhaViewModel}}, Path=ComecarCommand, x:DataType=vm:CozinhaViewModel}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{DynamicResource ColorSecondary}" TextColor="{DynamicResource ColorOnSecondary}" />
                                <Button Grid.Column="1" Style="{StaticResource SuccessButtonStyle}" Text="Pronto" IsVisible="{Binding PodeFinalizar}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CozinhaViewModel}}, Path=ProntoCommand, x:DataType=vm:CozinhaViewModel}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.ColumnSpan="2" Style="{StaticResource SecondaryButtonStyle}" Text="Voltar para preparo" IsVisible="{Binding PodeReabrir}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CozinhaViewModel}}, Path=ReabrirCommand, x:DataType=vm:CozinhaViewModel}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- O que será servido e quando -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Servicos}" IsVisible="{Binding AbaCardapio}" SelectionMode="None">
            <CollectionView.EmptyView>
                <controls:EmptyStateView Icon="{StaticResource IconMenuBook}"
                                         Title="Cardápio ainda vazio"
                                         Message="O cardápio do evento ainda não foi cadastrado no painel." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ServicoNaCozinha">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="14" StrokeShape="RoundRectangle 20">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource IconTileStyle}"
                                    WidthRequest="48" HeightRequest="48"
                                    StrokeShape="RoundRectangle 16">
                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="{Binding Horario}" FontSize="13" FontFamily="PlusJakartaSansSemibold"
                                           TextColor="{DynamicResource ColorBrandText}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Item}" FontFamily="InterSemibold" />
                                <Label Text="{Binding Quantidade}" Style="{StaticResource CaptionText}" />
                                <controls:StatusChip Text="{Binding Status}" Kind="{Binding StatusKind}" Margin="0,2,0,0" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="{Binding ProximaAcao}" VerticalOptions="Center"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CozinhaViewModel}}, Path=AvancarServicoCommand, x:DataType=vm:CozinhaViewModel}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{DynamicResource ColorSecondary}" TextColor="{DynamicResource ColorOnSecondary}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Produtos reservados para o evento -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Estoque}" IsVisible="{Binding AbaEstoque}" SelectionMode="None">
            <CollectionView.EmptyView>
                <controls:EmptyStateView Icon="{StaticResource IconInventory}"
                                         Title="Sem produtos reservados"
                                         Message="Nenhum produto foi reservado para este evento." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:EstoqueNaCozinha">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="14" StrokeShape="RoundRectangle 20">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Style="{StaticResource IconTileStyle}" WidthRequest="42" HeightRequest="42">
                                <Label Text="{StaticResource IconInventory}"
                                       Style="{StaticResource IconLabelOnAccent}" FontSize="20" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Nome}" FontFamily="InterSemibold" />
                                <Label Text="{Binding Detalhe}" Style="{StaticResource CaptionText}" />
                                <controls:StatusChip Text="Estoque baixo" Kind="error" Icon="{StaticResource IconWarning}"
                                                     IsVisible="{Binding Baixo}" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:LoadingSkeleton Grid.Row="2" IsVisible="{Binding CarregandoInicial}" />
    </Grid>
</ContentPage>
