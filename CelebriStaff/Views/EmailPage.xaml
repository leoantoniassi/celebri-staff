<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             xmlns:models="clr-namespace:CelebriStaff.Models"
             xmlns:controls="clr-namespace:CelebriStaff.Views.Controls"
             x:Class="CelebriStaff.Views.EmailPage"
             x:DataType="vm:EmailViewModel"
             Shell.NavBarIsVisible="False"
             Title="Celebri Staff">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="24" VerticalOptions="Center">

            <controls:BrandHero
                                Title="Celebri Staff"
                                Subtitle="Informe o e-mail cadastrado pelo seu buffet" />

            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0">
                <VerticalStackLayout Spacing="16">

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="{StaticResource IconMail}" Style="{StaticResource IconLabel}" />
                            <Entry Grid.Column="1"
                                   Placeholder="E-mail"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"
                                   SemanticProperties.Description="E-mail cadastrado" />
                        </Grid>
                    </Border>

                    <controls:ErrorBanner Message="{Binding ErrorMessage}" />

                    <Button Text="Continuar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ContinueCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

                    <!-- Aparece só quando o e-mail está em mais de um buffet. -->
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Buffets}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:BuffetIdentificado">
                                <Button Text="{Binding NomeFantasia}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EmailViewModel}}, Path=EscolherBuffetCommand, x:DataType=vm:EmailViewModel}"
                                        CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
