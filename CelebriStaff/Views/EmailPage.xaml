<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             xmlns:models="clr-namespace:CelebriStaff.Models"
             xmlns:controls="clr-namespace:CelebriStaff.Views.Controls"
             xmlns:behaviors="clr-namespace:CelebriStaff.Views.Behaviors"
             x:Class="CelebriStaff.Views.EmailPage"
             x:DataType="vm:EmailViewModel"
             behaviors:PageEntrance.Enabled="True"
             Shell.NavBarIsVisible="False"
             Title="Celebri Staff">

    <Grid>
        <Border StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,0,48"
                Background="{DynamicResource BrandGradientSoftBrush}"
                HeightRequest="260"
                VerticalOptions="Start"
                InputTransparent="True" />

        <ScrollView>
            <VerticalStackLayout Padding="24,40,24,32" Spacing="26" VerticalOptions="Center">

                <controls:BrandHero
                                    Title="Celebri Staff"
                                    Subtitle="Informe o e-mail cadastrado pelo seu buffet" />

                <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0">
                    <VerticalStackLayout Spacing="18">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="ACESSO DA EQUIPE" Style="{StaticResource Eyebrow}" />
                            <Label Text="Vamos identificar você" Style="{StaticResource Headline}" />
                        </VerticalStackLayout>

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="{StaticResource IconMail}"
                                       Style="{StaticResource IconLabel}"
                                       TextColor="{DynamicResource ColorBrandText}" />
                                <Entry Grid.Column="1"
                                       Placeholder="E-mail"
                                       Text="{Binding Email}"
                                       Keyboard="Email"
                                       IsSpellCheckEnabled="False"
                                       IsTextPredictionEnabled="False"
                                       SemanticProperties.Description="E-mail cadastrado" />
                            </Grid>
                        </Border>

                        <controls:ErrorBanner Message="{Binding ErrorMessage}" />

                        <Button Text="Continuar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ContinueCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

                        <!-- Aparece só quando o e-mail está em mais de um buffet. -->
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Buffets}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:BuffetIdentificado">
                                    <Button Text="{Binding NomeFantasia}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EmailViewModel}}, Path=EscolherBuffetCommand, x:DataType=vm:EmailViewModel}"
                                            CommandParameter="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="{StaticResource IconLock}"
                           Style="{StaticResource IconLabel}"
                           FontSize="14"
                           TextColor="{DynamicResource ColorTextSecondary}" />
                    <Label Text="Ambiente seguro · acesso do colaborador"
                           Style="{StaticResource CaptionText}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
