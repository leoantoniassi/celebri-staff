<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             xmlns:models="clr-namespace:CelebriStaff.Models"
             x:Class="CelebriStaff.Views.EmailPage"
             x:DataType="vm:EmailViewModel"
             Title="Celebri Staff">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <Label Text="Celebri Staff"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{DynamicResource ColorPrimary}" />

            <Label Text="Informe o e-mail cadastrado pelo seu buffet"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Entry Placeholder="E-mail"
                   Text="{Binding Email}"
                   Keyboard="Email"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Continuar"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{DynamicResource ColorPrimary}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <!-- Aparece só quando o e-mail está em mais de um buffet. -->
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Buffets}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:BuffetIdentificado">
                        <Button Text="{Binding NomeFantasia}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EmailViewModel}}, Path=EscolherBuffetCommand, x:DataType=vm:EmailViewModel}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="{DynamicResource ColorPrimary}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
