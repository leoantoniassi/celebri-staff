<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             xmlns:models="clr-namespace:CelebriStaff.Models"
             x:Class="CelebriStaff.Views.EmailPage"
             x:DataType="vm:EmailViewModel"
             Title="Celebri Staff">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="16" VerticalOptions="Center">

            <Label Text="Celebri Staff"
                   Style="{StaticResource TitleText}"
                   FontSize="28"
                   HorizontalOptions="Center"
                   TextColor="{DynamicResource ColorPrimary}" />

            <Label Text="Informe o e-mail cadastrado pelo seu buffet"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Border Style="{StaticResource InputBorderStyle}">
                <Entry Placeholder="E-mail"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       IsSpellCheckEnabled="False"
                       IsTextPredictionEnabled="False" />
            </Border>

            <Border StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource ColorSurfaceAlt}"
                    Padding="12"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextLabel}" />
            </Border>

            <Button Text="Continuar"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

            <!-- Aparece só quando o e-mail está em mais de um buffet. -->
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Buffets}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:BuffetIdentificado">
                        <Button Text="{Binding NomeFantasia}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EmailViewModel}}, Path=EscolherBuffetCommand, x:DataType=vm:EmailViewModel}"
                                CommandParameter="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
