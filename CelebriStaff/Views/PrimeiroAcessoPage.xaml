<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             x:Class="CelebriStaff.Views.PrimeiroAcessoPage"
             x:DataType="vm:PrimeiroAcessoViewModel"
             Title="Primeiro acesso">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="16" VerticalOptions="Center">

            <Label Text="{Binding NomeFantasia}"
                   Style="{StaticResource TitleText}"
                   HorizontalOptions="Center"
                   TextColor="{DynamicResource ColorPrimary}" />

            <Label Text="{Binding Instrucao}"
                   HorizontalTextAlignment="Center" />

            <Border Style="{StaticResource InputBorderStyle}">
                <Entry Placeholder="Código"
                       Text="{Binding Codigo}"
                       Keyboard="Numeric"
                       MaxLength="6" />
            </Border>

            <Border Style="{StaticResource InputBorderStyle}">
                <Entry Placeholder="Nova senha"
                       Text="{Binding Senha}"
                       IsPassword="True" />
            </Border>

            <Border Style="{StaticResource InputBorderStyle}">
                <Entry Placeholder="Confirme a senha"
                       Text="{Binding ConfirmacaoSenha}"
                       IsPassword="True" />
            </Border>

            <Border StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource ColorSurfaceAlt}"
                    Padding="12"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextLabel}" />
            </Border>

            <Label Text="{Binding InfoMessage}"
                   Style="{StaticResource CaptionText}"
                   IsVisible="{Binding InfoMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Criar senha e entrar"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding CriarSenhaCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <Button Text="Reenviar código"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ReenviarCodigoCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
