<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             xmlns:controls="clr-namespace:CelebriStaff.Views.Controls"
             x:Class="CelebriStaff.Views.PrimeiroAcessoPage"
             x:DataType="vm:PrimeiroAcessoViewModel"
             Title="Primeiro acesso">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="24" VerticalOptions="Center">

            <controls:BrandHero
                                Title="{Binding NomeFantasia}"
                                Subtitle="{Binding Instrucao}" />

            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0">
                <VerticalStackLayout Spacing="16">

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="{StaticResource IconBadge}" Style="{StaticResource IconLabel}" />
                            <Entry Grid.Column="1"
                                   Placeholder="Código de 6 dígitos"
                                   Text="{Binding Codigo}"
                                   Keyboard="Numeric"
                                   MaxLength="6"
                                   SemanticProperties.Description="Código recebido por e-mail" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="{StaticResource IconLock}" Style="{StaticResource IconLabel}" />
                            <Entry Grid.Column="1"
                                   Placeholder="Nova senha"
                                   Text="{Binding Senha}"
                                   IsPassword="True"
                                   SemanticProperties.Description="Nova senha" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="{StaticResource IconLock}" Style="{StaticResource IconLabel}" />
                            <Entry Grid.Column="1"
                                   Placeholder="Confirme a senha"
                                   Text="{Binding ConfirmacaoSenha}"
                                   IsPassword="True"
                                   SemanticProperties.Description="Confirmação da nova senha" />
                        </Grid>
                    </Border>

                    <controls:ErrorBanner Message="{Binding ErrorMessage}" />

                    <Label Text="{Binding InfoMessage}"
                           Style="{StaticResource CaptionText}"
                           IsVisible="{Binding InfoMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                    <Button Text="Criar senha e entrar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CriarSenhaCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <Button Text="Reenviar código"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ReenviarCodigoCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
