<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             xmlns:models="clr-namespace:CelebriStaff.Models"
             x:Class="CelebriStaff.Views.PortariaPage"
             x:DataType="vm:PortariaViewModel"
             Title="Portaria">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- Contador -->
        <Border Padding="16" StrokeShape="RoundRectangle 16" Stroke="#DDDDDD">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding EventoNome}" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="{Binding TotalTexto}" FontSize="56" FontAttributes="Bold"
                       HorizontalOptions="Center" TextColor="{DynamicResource ColorPrimary}"
                       AutomationId="TotalPresentes" />
                <Label Text="pessoas presentes" HorizontalOptions="Center" />
                <Label Text="{Binding PrevistoTexto}" HorizontalOptions="Center" TextColor="Gray" />
            </VerticalStackLayout>
        </Border>

        <!-- Entrada sem convite -->
        <Grid Grid.Row="1" ColumnDefinitions="*,2*" ColumnSpacing="8">
            <Button Text="− 1" Command="{Binding DesfazerAvulsoCommand}"
                    BackgroundColor="Transparent" TextColor="{DynamicResource ColorPrimary}"
                    BorderColor="{DynamicResource ColorPrimary}" BorderWidth="1" FontSize="20" />
            <Button Grid.Column="1" Text="+ 1 entrou" Command="{Binding EntrouAvulsoCommand}"
                    BackgroundColor="{DynamicResource ColorPrimary}" FontSize="20" />
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label Text="{Binding Erro}" TextColor="Red"
                   IsVisible="{Binding Erro, Converter={StaticResource StringNotEmptyConverter}}" />
            <Button Text="Ler QR code do convite" Command="{Binding LerQrCodeCommand}"
                    IsVisible="{Binding UsaConvites}" BackgroundColor="{DynamicResource ColorSecondary}" />
            <SearchBar Placeholder="Buscar convidado pelo nome" Text="{Binding Busca}"
                       IsVisible="{Binding UsaConvites}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Convites}" SelectionMode="None"
                        IsVisible="{Binding UsaConvites}">
            <CollectionView.EmptyView>
                <Label Text="Nenhum convidado encontrado." HorizontalOptions="Center" Margin="0,16" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ConvitePortaria">
                    <Border Margin="0,0,0,8" Padding="12" StrokeShape="RoundRectangle 12" Stroke="#DDDDDD">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PortariaViewModel}}, Path=AbrirConviteCommand, x:DataType=vm:PortariaViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label Text="{Binding Nome}" FontAttributes="Bold" />
                            <Label Text="{Binding Situacao}" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
