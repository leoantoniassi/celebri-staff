<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             xmlns:models="clr-namespace:CelebriStaff.Models"
             x:Class="CelebriStaff.Views.PortariaPage"
             x:DataType="vm:PortariaViewModel"
             Title="Portaria">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- Contador -->
        <Border Style="{StaticResource CardStyle}" Margin="0" Padding="16" StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding EventoNome}" Style="{StaticResource Headline}" HorizontalOptions="Center" />
                <Label Text="{Binding TotalTexto}" FontSize="56" FontAttributes="Bold"
                       HorizontalOptions="Center" TextColor="{DynamicResource ColorPrimary}"
                       AutomationId="TotalPresentes" />
                <Label Text="pessoas presentes" HorizontalOptions="Center" />
                <Label Text="{Binding PrevistoTexto}" HorizontalOptions="Center" Style="{StaticResource CaptionText}" />
            </VerticalStackLayout>
        </Border>

        <!-- Entrada sem convite -->
        <Grid Grid.Row="1" ColumnDefinitions="*,2*" ColumnSpacing="8">
            <Button Style="{StaticResource SecondaryButtonStyle}" Text="− 1" FontSize="20" Command="{Binding DesfazerAvulsoCommand}" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Text="+ 1 entrou" FontSize="20" Command="{Binding EntrouAvulsoCommand}" />
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label Text="{Binding Erro}" Style="{StaticResource ErrorTextLabel}"
                   IsVisible="{Binding Erro, Converter={StaticResource StringNotEmptyConverter}}" />
            <Button Text="Ler QR code do convite" Command="{Binding LerQrCodeCommand}"
                    IsVisible="{Binding UsaConvites}"
                    BackgroundColor="{DynamicResource ColorSecondary}" TextColor="{StaticResource ColorSurface}" />
            <SearchBar Placeholder="Buscar convidado pelo nome" Text="{Binding Busca}"
                       IsVisible="{Binding UsaConvites}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Convites}" SelectionMode="None"
                        IsVisible="{Binding UsaConvites}">
            <CollectionView.EmptyView>
                <StackLayout>
                    <Label Text="Nenhum convidado encontrado." Style="{StaticResource EmptyStateTitleStyle}" Margin="0,16" />
                </StackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ConvitePortaria">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12" StrokeShape="RoundRectangle 12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PortariaViewModel}}, Path=AbrirConviteCommand, x:DataType=vm:PortariaViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label Text="{Binding Nome}" FontAttributes="Bold" />
                            <Label Text="{Binding Situacao}" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
