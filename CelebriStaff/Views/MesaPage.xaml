<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             xmlns:models="clr-namespace:CelebriStaff.Models"
             x:Class="CelebriStaff.Views.MesaPage"
             x:DataType="vm:MesaViewModel"
             Title="Comanda">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="{Binding Titulo}" FontSize="20" FontAttributes="Bold" />

            <!-- Novo pedido -->
            <Border Padding="12" StrokeShape="RoundRectangle 14" Stroke="#DDDDDD">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Novo pedido" FontAttributes="Bold" />
                    <Entry Placeholder="Item (ex.: suco de uva, mais salgados)" Text="{Binding Descricao}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Button Text="−" Command="{Binding MenosCommand}" WidthRequest="56"
                                BackgroundColor="Transparent" TextColor="{DynamicResource ColorPrimary}"
                                BorderColor="{DynamicResource ColorPrimary}" BorderWidth="1" />
                        <Label Grid.Column="1" Text="{Binding Quantidade}" FontSize="22" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="+" Command="{Binding MaisCommand}" WidthRequest="56"
                                BackgroundColor="{DynamicResource ColorPrimary}" />
                    </Grid>
                    <Entry Placeholder="Anotação (ex.: sem gelo, sem glúten)" Text="{Binding ObservacaoItem}" />
                    <HorizontalStackLayout Spacing="6">
                        <CheckBox IsChecked="{Binding Alerta}" />
                        <Label Text="Alergia ou restrição (destaque na cozinha)" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Text="Adicionar item" Command="{Binding AdicionarItemCommand}"
                            BackgroundColor="Transparent" TextColor="{DynamicResource ColorPrimary}"
                            BorderColor="{DynamicResource ColorPrimary}" BorderWidth="1" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Novos}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PedidoItem">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Linha}" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="✕" BackgroundColor="Transparent" TextColor="#B3261E"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MesaViewModel}}, Path=RemoverItemCommand, x:DataType=vm:MesaViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Enviar pedido para a cozinha" Command="{Binding EnviarCommand}"
                            IsVisible="{Binding TemItens}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{DynamicResource ColorSecondary}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Mensagem}" HorizontalTextAlignment="Center"
                   IsVisible="{Binding Mensagem, Converter={StaticResource StringNotEmptyConverter}}" />

            <!-- Pedidos da mesa -->
            <Label Text="Pedidos desta mesa" FontAttributes="Bold" Margin="0,8,0,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pedidos}" Spacing="8">
                <BindableLayout.EmptyView>
                    <Label Text="Nenhum pedido ainda." TextColor="Gray" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PedidoDaMesa">
                        <Border Padding="12" StrokeShape="RoundRectangle 12" Stroke="#DDDDDD">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Cabecalho}" TextColor="{Binding Cor}" FontAttributes="Bold" />
                                <Label Text="{Binding Itens}" />
                                <Button Text="Entreguei na mesa" IsVisible="{Binding PodeEntregar}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MesaViewModel}}, Path=EntregarCommand, x:DataType=vm:MesaViewModel}"
                                        CommandParameter="{Binding .}" BackgroundColor="#1B7F3B" />
                                <Button Text="Cancelar pedido" IsVisible="{Binding PodeCancelar}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MesaViewModel}}, Path=CancelarCommand, x:DataType=vm:MesaViewModel}"
                                        CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="#B3261E" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
