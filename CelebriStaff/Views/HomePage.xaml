<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             xmlns:controls="clr-namespace:CelebriStaff.Views.Controls"
             x:Class="CelebriStaff.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Minhas Escalas">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sair" Command="{Binding LogoutCommand}"
                     SemanticProperties.Description="Sair da conta">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE9BA;" Size="24"
                                 Color="{DynamicResource ColorTextPrimary}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16,8,16,0">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,4,0,8">
            <!-- Avatar com a inicial do nome, na cor da marca -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 22"
                    BackgroundColor="{DynamicResource ColorPrimary}"
                    WidthRequest="44" HeightRequest="44" VerticalOptions="Start"
                    SemanticProperties.Description="Seu perfil">
                <Label Text="{Binding Inicial}"
                       Style="{StaticResource Headline}"
                       TextColor="{DynamicResource ColorOnPrimary}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding WelcomeMessage}"
                       Style="{StaticResource TitleText}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding Aviso}"
                       Style="{StaticResource CaptionText}"
                       IsVisible="{Binding Aviso, Converter={StaticResource StringNotEmptyConverter}}" />
            </VerticalStackLayout>
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding CarregarCommand}">
            <CollectionView ItemsSource="{Binding Grupos}" IsGrouped="True" SelectionMode="None">

                <CollectionView.Footer>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Footer>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:GrupoEscalas">
                        <Label Text="{Binding Titulo}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="4,16,0,8"
                               SemanticProperties.HeadingLevel="Level2" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.EmptyView>
                    <controls:EmptyStateView Icon="{StaticResource IconEvent}"
                                             Title="Nenhuma escala por aqui"
                                             Message="Você ainda não foi escalado para nenhum evento. Puxe a lista para atualizar." />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:EscalaCardViewModel">
                        <Border Style="{StaticResource CardStyle}">
                            <VerticalStackLayout Spacing="10">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding NomeEvento}" Style="{StaticResource Headline}" />
                                        <Label Text="{Binding Quando}" Style="{StaticResource CaptionText}" />
                                    </VerticalStackLayout>
                                    <controls:StatusChip Grid.Column="1"
                                                         VerticalOptions="Start"
                                                         Text="{Binding Status}"
                                                         Kind="{Binding StatusKind}"
                                                         Icon="{Binding StatusIcon}" />
                                </Grid>

                                <BoxView HeightRequest="1" />

                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                    <Label Text="{StaticResource IconBadge}" Style="{StaticResource IconLabel}" FontSize="18" />
                                    <Label Grid.Column="1" Text="{Binding Funcao}" Style="{StaticResource BodyText}" VerticalOptions="Center" />

                                    <Label Grid.Row="1" Text="{StaticResource IconPlace}" Style="{StaticResource IconLabel}" FontSize="18"
                                           IsVisible="{Binding Local, Converter={StaticResource StringNotEmptyConverter}}" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Local}" Style="{StaticResource CaptionText}" VerticalOptions="Center"
                                           IsVisible="{Binding Local, Converter={StaticResource StringNotEmptyConverter}}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0" IsVisible="{Binding PodeResponder}">
                                    <Button Text="Confirmar" Style="{StaticResource PrimaryButtonStyle}"
                                            IsVisible="{Binding PodeConfirmar}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=ConfirmarCommand, x:DataType=vm:HomeViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="1" Text="Recusar" Style="{StaticResource DangerButtonStyle}"
                                            IsVisible="{Binding PodeRecusar}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=RecusarCommand, x:DataType=vm:HomeViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>

                                <Button Text="Cheguei no evento"
                                        IsVisible="{Binding PodeFazerCheckin}"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=CheckinCommand, x:DataType=vm:HomeViewModel}"
                                        CommandParameter="{Binding .}" />

                                <Button Text="{Binding TextoModulo}"
                                        IsVisible="{Binding PodeAbrirModulo}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=AbrirModuloCommand, x:DataType=vm:HomeViewModel}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <controls:LoadingSkeleton Grid.Row="1" IsVisible="{Binding CarregandoInicial}" />
    </Grid>
</ContentPage>
