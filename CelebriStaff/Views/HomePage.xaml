<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             x:Class="CelebriStaff.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Minhas Escalas">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sair" Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16,8,16,8">

        <VerticalStackLayout Spacing="4" Margin="0,0,0,8">
            <Label Text="{Binding WelcomeMessage}" Style="{StaticResource TitleText}" />
            <Label Text="{Binding Aviso}"
                   Style="{StaticResource CaptionText}"
                   IsVisible="{Binding Aviso, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding CarregarCommand}">
            <CollectionView ItemsSource="{Binding Grupos}" IsGrouped="True" SelectionMode="None">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:GrupoEscalas">
                        <Label Text="{Binding Titulo}" Style="{StaticResource SectionHeaderStyle}" Margin="4,16,0,6" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32,64" Spacing="8">
                        <Label Text="Nenhuma escala por aqui" Style="{StaticResource EmptyStateTitleStyle}" />
                        <Label Text="Você ainda não foi escalado para nenhum evento."
                               Style="{StaticResource EmptyStateMessageStyle}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:EscalaCardViewModel">
                        <Border Style="{StaticResource CardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                                    <Label Text="{Binding NomeEvento}" Style="{StaticResource Headline}" />
                                    <Label Grid.Row="1" Text="{Binding Quando}" Style="{StaticResource CaptionText}" />
                                </Grid>

                                <Label Text="{Binding Local, StringFormat='📍 {0}'}"
                                       Style="{StaticResource CaptionText}"
                                       IsVisible="{Binding Local, Converter={StaticResource StringNotEmptyConverter}}" />

                                <Label Text="{Binding Funcao, StringFormat='Função: {0}'}" Style="{StaticResource BodyText}" />

                                <Label Text="{Binding Status}" Style="{StaticResource StatusBadgeStyle}"
                                       TextColor="{Binding StatusCor}" />

                                <HorizontalStackLayout Spacing="8" Margin="0,4,0,0" IsVisible="{Binding PodeResponder}">
                                    <Button Text="Confirmar" Style="{StaticResource PrimaryButtonStyle}"
                                            IsVisible="{Binding PodeConfirmar}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=ConfirmarCommand, x:DataType=vm:HomeViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Recusar" Style="{StaticResource DangerButtonStyle}"
                                            IsVisible="{Binding PodeRecusar}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=RecusarCommand, x:DataType=vm:HomeViewModel}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>

                                <Button Text="Cheguei no evento"
                                        IsVisible="{Binding PodeFazerCheckin}"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=CheckinCommand, x:DataType=vm:HomeViewModel}"
                                        CommandParameter="{Binding .}" />

                                <Button Text="{Binding TextoModulo}"
                                        IsVisible="{Binding PodeAbrirModulo}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=AbrirModuloCommand, x:DataType=vm:HomeViewModel}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
