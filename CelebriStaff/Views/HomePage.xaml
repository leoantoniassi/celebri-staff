<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             xmlns:controls="clr-namespace:CelebriStaff.Views.Controls"
             xmlns:behaviors="clr-namespace:CelebriStaff.Views.Behaviors"
             x:Class="CelebriStaff.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             behaviors:PageEntrance.Enabled="True"
             Title="Minhas Escalas">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sair" Command="{Binding LogoutCommand}"
                     SemanticProperties.Description="Sair da conta">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE9BA;" Size="24"
                                 Color="{DynamicResource ColorTextPrimary}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16,8,16,0" RowSpacing="4">

        <Border Style="{StaticResource HeroCardStyle}" Padding="18" Margin="0,4,0,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                <!-- Avatar com a inicial do nome, em anel gradiente -->
                <Grid WidthRequest="54" HeightRequest="54" VerticalOptions="Center"
                      SemanticProperties.Description="Seu perfil">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 27"
                            Background="{DynamicResource BrandGradientBrush}" />
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 24"
                            BackgroundColor="{DynamicResource ColorSurface}"
                            Margin="3">
                        <Label Text="{Binding Inicial}"
                               Style="{StaticResource Headline}"
                               FontSize="19"
                               TextColor="{DynamicResource ColorBrandText}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="{Binding WelcomeMessage}"
                           Style="{StaticResource TitleText}"
                           FontSize="22"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding Aviso}"
                           Style="{StaticResource CaptionText}"
                           IsVisible="{Binding Aviso, Converter={StaticResource StringNotEmptyConverter}}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding CarregarCommand}">
            <CollectionView ItemsSource="{Binding Grupos}" IsGrouped="True" SelectionMode="None">

                <CollectionView.Footer>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Footer>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:GrupoEscalas">
                        <HorizontalStackLayout Spacing="8" Margin="4,18,0,10">
                            <BoxView WidthRequest="4" HeightRequest="16" CornerRadius="2"
                                     Color="{DynamicResource ColorPrimary}"
                                     VerticalOptions="Center" />
                            <Label Text="{Binding Titulo}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   VerticalOptions="Center"
                                   SemanticProperties.HeadingLevel="Level2" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.EmptyView>
                    <controls:EmptyStateView Icon="{StaticResource IconEvent}"
                                             Title="Nenhuma escala por aqui"
                                             Message="Você ainda não foi escalado para nenhum evento. Puxe a lista para atualizar." />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:EscalaCardViewModel">
                        <Border Style="{StaticResource CardStyle}" Padding="0">
                            <Grid>
                                <Border StrokeThickness="0"
                                        HeightRequest="6"
                                        VerticalOptions="Start"
                                        Background="{DynamicResource BrandGradientBrush}" />

                                <VerticalStackLayout Padding="18,22,18,18" Spacing="14">

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="{Binding NomeEvento}" Style="{StaticResource Headline}" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{StaticResource IconEvent}"
                                                       Style="{StaticResource IconLabel}"
                                                       FontSize="14"
                                                       TextColor="{DynamicResource ColorBrandText}" />
                                                <Label Text="{Binding Quando}"
                                                       Style="{StaticResource CaptionText}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <controls:StatusChip Grid.Column="1"
                                                             VerticalOptions="Start"
                                                             Text="{Binding Status}"
                                                             Kind="{Binding StatusKind}"
                                                             Icon="{Binding StatusIcon}" />
                                    </Grid>

                                    <Border Style="{StaticResource SoftCardStyle}" Padding="12,10">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border Style="{StaticResource IconTileStyle}" WidthRequest="36" HeightRequest="36">
                                                <Label Text="{StaticResource IconBadge}"
                                                       Style="{StaticResource IconLabelOnAccent}"
                                                       FontSize="18" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="SUA FUNÇÃO" Style="{StaticResource Eyebrow}" FontSize="10" />
                                                <Label Text="{Binding Funcao}" Style="{StaticResource BodyText}"
                                                       FontFamily="InterSemibold" />
                                                <HorizontalStackLayout Spacing="5"
                                                                       IsVisible="{Binding Local, Converter={StaticResource StringNotEmptyConverter}}">
                                                    <Label Text="{StaticResource IconPlace}"
                                                           Style="{StaticResource IconLabel}"
                                                           FontSize="13" />
                                                    <Label Text="{Binding Local}"
                                                           Style="{StaticResource CaptionText}"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,2,0,0" IsVisible="{Binding PodeResponder}">
                                        <Button Text="Confirmar" Style="{StaticResource PrimaryButtonStyle}"
                                                FontSize="14"
                                                MinimumHeightRequest="46"
                                                IsVisible="{Binding PodeConfirmar}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=ConfirmarCommand, x:DataType=vm:HomeViewModel}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="Recusar" Style="{StaticResource DangerButtonStyle}"
                                                FontSize="14"
                                                MinimumHeightRequest="46"
                                                IsVisible="{Binding PodeRecusar}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=RecusarCommand, x:DataType=vm:HomeViewModel}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                    <Button Text="Cheguei no evento"
                                            IsVisible="{Binding PodeFazerCheckin}"
                                            Style="{StaticResource SuccessButtonStyle}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=CheckinCommand, x:DataType=vm:HomeViewModel}"
                                            CommandParameter="{Binding .}" />

                                    <Button Text="{Binding TextoModulo}"
                                            IsVisible="{Binding PodeAbrirModulo}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=AbrirModuloCommand, x:DataType=vm:HomeViewModel}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <controls:LoadingSkeleton Grid.Row="1" IsVisible="{Binding CarregandoInicial}" />
    </Grid>
</ContentPage>
