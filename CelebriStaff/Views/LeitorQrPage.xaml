<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="CelebriStaff.Views.LeitorQrPage"
             Title="Ler QR code">

    <Grid RowDefinitions="*,Auto">
        <Grid>
            <zxing:CameraBarcodeReaderView x:Name="Leitor"
                                           BarcodesDetected="OnBarcodesDetected" />

            <!-- Moldura de leitura: quatro cantos na cor da marca sobre a câmera -->
            <Grid WidthRequest="240" HeightRequest="240"
                  HorizontalOptions="Center" VerticalOptions="Center"
                  InputTransparent="True">
                <Border StrokeThickness="3" Stroke="{DynamicResource ColorPrimary}"
                        StrokeShape="RoundRectangle 24" BackgroundColor="Transparent" />
            </Grid>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="20,16" Spacing="8" BackgroundColor="{DynamicResource ColorSurface}">
            <Label x:Name="Mensagem" Text="Aponte a câmera para o QR code do convite."
                   Style="{StaticResource BodyText}"
                   HorizontalTextAlignment="Center"
                   SemanticProperties.Description="Instrução do leitor de QR code" />
            <ActivityIndicator x:Name="Carregando" IsRunning="False" IsVisible="False" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
