<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CelebriStaff.Views.Controls.QuantityStepper"
             HorizontalOptions="Center">

    <!-- Seletor − n + com alvos de toque de 52px. -->
    <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
        <Button x:Name="MinusButton"
                Text="{StaticResource IconRemove}"
                FontFamily="MaterialIcons"
                FontSize="24"
                Padding="0"
                WidthRequest="52"
                HeightRequest="52"
                CornerRadius="26"
                Style="{StaticResource SecondaryButtonStyle}"
                SemanticProperties.Description="Diminuir quantidade" />

        <Label x:Name="ValueLabel"
               FontSize="36"
               FontFamily="InterSemibold"
               MinimumWidthRequest="64"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center" />

        <Button x:Name="PlusButton"
                Text="{StaticResource IconAdd}"
                FontFamily="MaterialIcons"
                FontSize="24"
                Padding="0"
                WidthRequest="52"
                HeightRequest="52"
                CornerRadius="26"
                Style="{StaticResource PrimaryButtonStyle}"
                SemanticProperties.Description="Aumentar quantidade" />
    </HorizontalStackLayout>
</ContentView>
