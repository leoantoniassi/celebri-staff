<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CelebriStaff.Views.Controls.EmptyStateView">

    <!-- Estado vazio: ícone em disco suave + título + mensagem + ação opcional. -->
    <VerticalStackLayout Padding="32,44" Spacing="14" HorizontalOptions="Center">

        <Grid WidthRequest="92" HeightRequest="92" HorizontalOptions="Center">
            <Border x:Name="IconDisc"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 46"
                    Background="{DynamicResource BrandGradientSoftBrush}" />
            <Border StrokeThickness="1"
                    Stroke="{DynamicResource ColorBorder}"
                    StrokeShape="RoundRectangle 34"
                    BackgroundColor="{DynamicResource ColorSurface}"
                    Margin="11">
                <Label x:Name="IconView"
                       Style="{StaticResource IconLabelLarge}"
                       FontSize="36"
                       TextColor="{DynamicResource ColorOnAccentSoft}" />
            </Border>
        </Grid>

        <Label x:Name="TitleView" Style="{StaticResource EmptyStateTitleStyle}" />
        <Label x:Name="MessageView" Style="{StaticResource EmptyStateMessageStyle}" />

        <Button x:Name="ActionButton"
                Style="{StaticResource SecondaryButtonStyle}"
                HorizontalOptions="Center"
                Margin="0,8,0,0"
                IsVisible="False" />
    </VerticalStackLayout>
</ContentView>
