<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CelebriStaff.Views.Controls.BrandHero">

    <!-- Cabeçalho das telas de entrada: logo do buffet (ou emblema Celebri), título e subtítulo. -->
    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">

        <!-- Logo oficial Celebri (mesmo arquivo do painel web), usado quando o buffet não tem logo. -->
        <Image x:Name="Emblem"
               Source="logo_celebri.png"
               WidthRequest="96"
               HeightRequest="96"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               SemanticProperties.Description="Logo Celebri" />

        <Image x:Name="LogoView"
               HeightRequest="84"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               IsVisible="False" />

        <Label x:Name="TitleView"
               Style="{StaticResource TitleText}"
               FontSize="26"
               TextColor="{DynamicResource ColorBrandText}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               SemanticProperties.HeadingLevel="Level1" />

        <Label x:Name="SubtitleView"
               Style="{StaticResource CaptionText}"
               FontSize="14"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               IsVisible="False" />
    </VerticalStackLayout>
</ContentView>
