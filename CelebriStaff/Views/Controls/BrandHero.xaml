<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CelebriStaff.Views.Controls.BrandHero">

    <!-- Cabeçalho das telas de entrada: logo do buffet (ou emblema Celebri), título e subtítulo. -->
    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">

        <Grid WidthRequest="112" HeightRequest="112" HorizontalOptions="Center">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 38"
                    Background="{DynamicResource BrandGradientSoftBrush}" />
            <Border StrokeThickness="1"
                    Stroke="{DynamicResource ColorBorder}"
                    StrokeShape="RoundRectangle 30"
                    BackgroundColor="{DynamicResource ColorSurface}"
                    Margin="11"
                    Padding="10">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource ColorShadow}" Offset="0,8" Radius="22" Opacity="0.9" />
                </Border.Shadow>
                <Grid>
                    <!-- Logo oficial Celebri (mesmo arquivo do painel web), usado quando o buffet não tem logo. -->
                    <Image x:Name="Emblem"
                           Source="logo_celebri.png"
                           WidthRequest="58"
                           HeightRequest="58"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Logo Celebri" />

                    <Image x:Name="LogoView"
                           HeightRequest="58"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="False" />
                </Grid>
            </Border>
        </Grid>

        <VerticalStackLayout Spacing="6">
            <Label x:Name="TitleView"
                   Style="{StaticResource TitleText}"
                   FontSize="28"
                   TextColor="{DynamicResource ColorTextPrimary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label x:Name="SubtitleView"
                   Style="{StaticResource BodyText}"
                   FontSize="14"
                   TextColor="{DynamicResource ColorTextSecondary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="False" />
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
