<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CelebriStaff.Views.Controls.LoadingSkeleton"
             BackgroundColor="{DynamicResource ColorBackground}">

    <!-- Carga inicial: cartões "fantasma" pulsando, no lugar da lista. -->
    <VerticalStackLayout x:Name="Host" Padding="16,8" Spacing="14" InputTransparent="True">
        <VerticalStackLayout.Resources>
            <Style x:Key="Bone" TargetType="BoxView">
                <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceContainer}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>
        </VerticalStackLayout.Resources>

        <Border StrokeThickness="0" StrokeShape="RoundRectangle 26" Padding="18"
                BackgroundColor="{DynamicResource ColorSurfaceAlt}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <BoxView Style="{StaticResource Bone}" WidthRequest="52" HeightRequest="52" CornerRadius="18" />
                <VerticalStackLayout Grid.Column="1" Spacing="9" VerticalOptions="Center">
                    <BoxView Style="{StaticResource Bone}" WidthRequest="170" HeightRequest="15" />
                    <BoxView Style="{StaticResource Bone}" WidthRequest="110" HeightRequest="11" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Border Stroke="{DynamicResource ColorBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 22"
                BackgroundColor="{DynamicResource ColorSurface}" Padding="18">
            <VerticalStackLayout Spacing="12">
                <BoxView Style="{StaticResource Bone}" WidthRequest="180" HeightRequest="16" />
                <BoxView Style="{StaticResource Bone}" WidthRequest="120" HeightRequest="12" />
                <BoxView Style="{StaticResource Bone}" WidthRequest="220" HeightRequest="12" />
                <BoxView Style="{StaticResource Bone}" HorizontalOptions="Fill" HeightRequest="46" CornerRadius="14" />
            </VerticalStackLayout>
        </Border>

        <Border Stroke="{DynamicResource ColorBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 22"
                BackgroundColor="{DynamicResource ColorSurface}" Padding="18">
            <VerticalStackLayout Spacing="12">
                <BoxView Style="{StaticResource Bone}" WidthRequest="150" HeightRequest="16" />
                <BoxView Style="{StaticResource Bone}" WidthRequest="200" HeightRequest="12" />
                <BoxView Style="{StaticResource Bone}" WidthRequest="100" HeightRequest="12" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
