<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CelebriStaff.Views.Controls.StatusChip"
             HorizontalOptions="Start">

    <!-- Pílula de status: fundo suave + texto/ícone legíveis nos temas claro e escuro.
         Kind: success | warning | error | info | neutral -->
    <Border x:Name="Chip"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            Padding="10,4">
        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
            <Label x:Name="IconView"
                   Style="{StaticResource IconLabel}"
                   FontSize="14"
                   IsVisible="False" />
            <Label x:Name="TextView"
                   FontSize="12"
                   FontFamily="InterSemibold"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
