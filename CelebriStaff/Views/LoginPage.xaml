<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CelebriStaff.ViewModels"
             xmlns:controls="clr-namespace:CelebriStaff.Views.Controls"
             x:Class="CelebriStaff.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Entrar">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="24" VerticalOptions="Center">

            <controls:BrandHero
                                LogoUrl="{Binding LogoUrl}"
                                Title="{Binding NomeFantasia}"
                                Subtitle="Entre com seu e-mail e senha" />

            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0">
                <VerticalStackLayout Spacing="16">

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="{StaticResource IconMail}" Style="{StaticResource IconLabel}" />
                            <Entry Grid.Column="1"
                                   Placeholder="E-mail"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"
                                   SemanticProperties.Description="E-mail" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="{StaticResource IconLock}" Style="{StaticResource IconLabel}" />
                            <Entry Grid.Column="1"
                                   Placeholder="Senha"
                                   Text="{Binding Senha}"
                                   IsPassword="True"
                                   SemanticProperties.Description="Senha" />
                        </Grid>
                    </Border>

                    <controls:ErrorBanner Message="{Binding ErrorMessage}" />

                    <Button Text="Entrar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
