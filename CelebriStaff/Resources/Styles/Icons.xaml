    <Style TargetType="Label" x:Key="IconLabel">
        <Setter Property="FontFamily" Value="MaterialIcons" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextSecondary}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="IconLabelLarge" BasedOn="{StaticResource IconLabel}">
        <Setter Property="FontSize" Value="48" />
        <Setter Property="TextColor" Value="{DynamicResource ColorBrandText}" />
    </Style>
</ResourceDictionary>
