<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================
         ESTILOS IMPLÍCITOS (globais) — design system contemporâneo
         ============================================================ -->

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource ColorPrimary}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{DynamicResource ColorBorder}" />
        <Setter Property="SelectedIndicatorColor" Value="{DynamicResource ColorPrimary}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorBorder}" />
    </Style>

    <Style TargetType="Border" x:Key="BorderBaseStyle">
        <Setter Property="Stroke" Value="{DynamicResource ColorBorder}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
    </Style>

    <Style TargetType="Border" BasedOn="{StaticResource BorderBaseStyle}" />

    <Style TargetType="Button" x:Key="ButtonBaseStyle">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnPrimary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorPrimary}" />
        <Setter Property="FontFamily" Value="InterSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource ColorTextSecondary}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceContainer}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.9" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}" />

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource ColorPrimary}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextSecondary}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextSecondary}" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="TitleColor" Value="{DynamicResource ColorTextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource ColorPrimary}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource ColorPrimary}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextSecondary}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource ColorTextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="26" />
        <Setter Property="Opacity" Value="0.9" />
        <Setter Property="Brush" Value="{DynamicResource ColorShadow}" />
        <Setter Property="Offset" Value="0,10" />
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource ColorPrimary}" />
        <Setter Property="ThumbColor" Value="{DynamicResource ColorSurface}" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorBackground}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource ColorBackground}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource ColorBorder}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource ColorTextSecondary}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource ColorSurface}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource ColorBrandText}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource ColorBrandText}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource ColorTextSecondary}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource ColorBackground}" />
        <Setter Property="BarTextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="IconColor" Value="{DynamicResource ColorTextPrimary}" />
    </Style>

    <!-- ============================================================
         TIPOGRAFIA
         ============================================================ -->

    <Style TargetType="Label" x:Key="DisplayText">
        <Setter Property="FontFamily" Value="PlusJakartaSansBold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <Style TargetType="Label" x:Key="TitleText">
        <Setter Property="FontFamily" Value="PlusJakartaSansBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="FontFamily" Value="PlusJakartaSansSemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>

    <Style TargetType="Label" x:Key="SubHeadline">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="LineHeight" Value="1.35" />
    </Style>

    <Style TargetType="Label" x:Key="BodyText">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="LineHeight" Value="1.35" />
    </Style>

    <Style TargetType="Label" x:Key="CaptionText">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextSecondary}" />
        <Setter Property="LineHeight" Value="1.35" />
    </Style>

    <Style TargetType="Label" x:Key="Eyebrow">
        <Setter Property="FontFamily" Value="InterSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.6" />
        <Setter Property="TextColor" Value="{DynamicResource ColorBrandText}" />
    </Style>

    <Style TargetType="Label" x:Key="SectionHeaderStyle">
        <Setter Property="FontFamily" Value="PlusJakartaSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextColor" Value="{DynamicResource ColorBrandText}" />
    </Style>

    <Style TargetType="Label" x:Key="ErrorTextLabel">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource ColorError}" />
    </Style>

    <!-- ============================================================
         BOTÕES
         ============================================================ -->

    <Style TargetType="Button" x:Key="PrimaryButtonStyle" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnGradient}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" />
        <Setter Property="FontFamily" Value="InterSemibold" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{DynamicResource ColorShadow}" Offset="0,8" Radius="20" Opacity="0.9" />
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{x:Null}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceContainer}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorTextSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.9" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="SecondaryButtonStyle" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="TextColor" Value="{DynamicResource ColorBrandText}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceAlt}" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style TargetType="Button" x:Key="TonalButtonStyle" BasedOn="{StaticResource SecondaryButtonStyle}" />

    <Style TargetType="Button" x:Key="GhostButtonStyle" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="TextColor" Value="{DynamicResource ColorBrandText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Button" x:Key="DangerButtonStyle" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnErrorContainer}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorErrorContainer}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style TargetType="Button" x:Key="SuccessButtonStyle" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="TextColor" Value="{DynamicResource ColorSurface}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSuccess}" />
    </Style>

    <Style TargetType="Button" x:Key="GradientButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}" />

    <!-- Botões compactos (grelhas de mesa / cards de cozinha) -->
    <Style TargetType="Button" x:Key="CompactButtonStyle" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="42" />
    </Style>

    <Style TargetType="Button" x:Key="CompactDangerButtonStyle" BasedOn="{StaticResource CompactButtonStyle}">
        <Setter Property="TextColor" Value="{DynamicResource ColorOnErrorContainer}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorErrorContainer}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style TargetType="Button" x:Key="IconButtonStyle" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="FontFamily" Value="MaterialIcons" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="WidthRequest" Value="46" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="MinimumHeightRequest" Value="46" />
        <Setter Property="MinimumWidthRequest" Value="46" />
        <Setter Property="TextColor" Value="{DynamicResource ColorBrandText}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceAlt}" />
    </Style>

    <!-- ============================================================
         CAMPOS DE FORMULÁRIO
         ============================================================ -->

    <Style TargetType="Border" x:Key="InputBorderStyle" BasedOn="{StaticResource BorderBaseStyle}">
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceAlt}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="54" />
    </Style>

    <!-- ============================================================
         CARDS
         ============================================================ -->

    <Style TargetType="Border" x:Key="CardStyle" BasedOn="{StaticResource BorderBaseStyle}">
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{DynamicResource ColorShadow}" Offset="0,10" Radius="26" Opacity="0.9" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="SoftCardStyle" BasedOn="{StaticResource BorderBaseStyle}">
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurfaceAlt}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style TargetType="Border" x:Key="HeroCardStyle" BasedOn="{StaticResource CardStyle}">
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource BrandGradientSoftBrush}" />
    </Style>

    <!-- Badge / chip de status -->
    <Style TargetType="Label" x:Key="StatusBadgeStyle">
        <Setter Property="FontFamily" Value="InterSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- Mensagem de estado vazio -->
    <Style TargetType="Label" x:Key="EmptyStateTitleStyle">
        <Setter Property="FontFamily" Value="PlusJakartaSansSemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
    </Style>

    <Style TargetType="Label" x:Key="EmptyStateMessageStyle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextSecondary}" />
    </Style>

</ResourceDictionary>
