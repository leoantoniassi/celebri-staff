<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FestifyStaff.ViewModels"
             x:Class="FestifyStaff.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Entrar">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <Image Source="{Binding LogoUrl}"
                   HeightRequest="80"
                   Aspect="AspectFit"
                   IsVisible="{Binding LogoUrl, Converter={StaticResource StringNotEmptyConverter}}" />

            <Label Text="{Binding NomeFantasia}"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{DynamicResource ColorPrimary}" />

            <Entry Placeholder="Email"
                   Text="{Binding Email}"
                   Keyboard="Email"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False" />

            <Entry Placeholder="Senha"
                   Text="{Binding Senha}"
                   IsPassword="True" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Entrar"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{DynamicResource ColorPrimary}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
