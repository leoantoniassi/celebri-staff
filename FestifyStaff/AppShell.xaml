<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FestifyStaff.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FestifyStaff.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="False"
    Title="Festify Staff">

    <ShellContent
        Title="Empresa"
        ContentTemplate="{DataTemplate views:TenantCodePage}"
        Route="tenant" />

    <!-- "home" precisa ser ShellContent (não apenas RegisterRoute) para que
         GoToAsync("//home") possa virar a única página da pilha após o
         login — o Shell não permite isso para rotas globais avulsas. -->
    <ShellContent
        Title="Minhas Escalas"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="home" />

</Shell>
